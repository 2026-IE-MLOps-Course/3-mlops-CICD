# .dockerignore
# Lean serving image: allow-list strategy
# Ignore everything, then allow only what the API needs at runtime

**

# Build recipe and locked environment
!Dockerfile
!conda-lock.yml

# Runtime config and application code
!config.yaml
!src/
!src/**

# Local model fallback (used when MODEL_SOURCE=local)
!models/
!models/**

# Safety net: never ship these even if a rule above changes
**/__pycache__
**/*.pyc
.env
.env.*

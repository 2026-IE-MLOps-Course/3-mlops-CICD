# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Environments and secrets
.env
.env.*
!.env.example
.venv/
env/
venv/

# Tooling
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/

# OS and IDE
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json

# -----------------------------
# Data
# Default rule: data never goes to Git (real data may contain personal or confidential information)
# Exception: the small SYNTHETIC teaching files below, so anyone (and CI) can run the pipeline after cloning
# -----------------------------
data/**
!data/
!data/raw/
!data/processed/
!data/inference/
!data/**/.gitkeep
!data/raw/opioid_raw_data.csv
!data/inference/opioid_infer_01.csv

# -----------------------------
# Generated outputs (recreated by: python -m src.main)
# -----------------------------
models/**
!models/
!models/.gitkeep

reports/**
!reports/
!reports/.gitkeep

logs/
*.log

# Weights & Biases local files and downloaded artifacts
wandb/
artifacts/

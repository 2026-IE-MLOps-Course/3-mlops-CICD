# -----------------------------
# Data
# Default rule: data never goes to Git (real data may contain personal or confidential information)
# Data now lives in DagsHub through DVC (.dvc pointer files stay in Git; git clone then dvc pull)
# -----------------------------
data/**/*.csv

# -----------------------------
# Generated outputs (recreated by: python -m src.main)
# -----------------------------
models/**
!models/
!models/.gitkeep

reports/**
!reports/
!reports/.gitkeep

logs/
*.log

# Weights & Biases local files and downloaded artifacts
wandb/
artifacts/

# Copy this file to .dvc/config.local in your clone.
# Replace both placeholders with YOUR own DagsHub credentials and save.
# Token: https://dagshub.com/user/settings/tokens
# .dvc/config.local is ignored by Git. Never put real credentials in this example.
['remote "dagshub"']
    auth = basic
    user = YOUR_DAGSHUB_USERNAME
    password = YOUR_DAGSHUB_TOKEN

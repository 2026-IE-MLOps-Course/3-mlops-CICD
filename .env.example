# .env.example
# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env is listed in .gitignore and .dockerignore, so your real secrets never reach GitHub or the image
# This example file has NO real secrets and IS committed, so teammates know which variables exist

# Weights & Biases (W&B): https://wandb.ai/authorize
WANDB_API_KEY=paste_your_key_here
WANDB_ENTITY=your_wandb_username_or_team
# online | offline | disabled
WANDB_MODE=online

# Where the API loads the model from: local (models/model.joblib) or wandb (registry alias)
MODEL_SOURCE=local
WANDB_MODEL_ALIAS=prod
